# PortfolioIQ API configuration (copy to server/.env to override; all optional).
# No secrets and no database settings are needed: the app reads local JSON files only.

# HTTP listener
PORT=3000
HOST=127.0.0.1

# Browser origins allowed to call the API (comma separated). Sencha Cmd serves
# the Ext JS app on http://localhost:1841 by default.
CORS_ORIGINS=http://localhost:1841,http://127.0.0.1:1841

# Log one line per request (true/false)
LOG_REQUESTS=true

# Optional: override the active market scenario (normal, bull, bear, volatile,
# correction, recovery). Defaults to simulation.default_scenario_id in
# server/data/fixtures/market-config.json.
# SIMULATION_SCENARIO=normal

# Simulation tick duration, speed and seed are configured in
# server/data/fixtures/market-config.json (tick_duration_ms, simulation_speed, seed).
